# ═══════════════════════════════════════════════════════════
#  VAVINA LEARNERS BACKEND — Environment Variables
#  Copy this to .env and fill in your values.
#  NEVER commit .env to GitHub.
# ═══════════════════════════════════════════════════════════

# ── Notes generation (Groq AI) ──────────────────────────────
NOTES_MAKER_API=gsk_your_groq_key_here

# ── Video generation (Groq AI — same key is fine) ───────────
GROQ_API_KEY=gsk_your_groq_key_here

# ── Daily tech news ─────────────────────────────────────────
NEWS_API_KEY=your_newsapi_org_key_here

# ── Cloudinary (replaces Supabase) ──────────────────────────
CLOUDINARY_CLOUD_NAME=wzflnd0t
CLOUDINARY_API_KEY=939355222738251
CLOUDINARY_API_SECRET=PASTE_YOUR_FULL_API_SECRET_HERE

# ── Firebase Admin SDK ───────────────────────────────────────
# Paste entire serviceAccountKey.json as ONE LINE (no newlines).
# Get it: Firebase Console → Project Settings → Service accounts → Generate new private key
# Convert: cat serviceAccountKey.json | tr -d '\n'
FIREBASE_CRED_JSON={"type":"service_account","project_id":"your-project","private_key_id":"abc","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"123","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Server port (Render sets this automatically) ─────────────
PORT=3000
