# ═══════════════════════════════════════════════════════════
#  VAVINA LEARNERS BACKEND — Environment Variables
#  Copy this to .env and fill in your values.
#  NEVER commit .env to GitHub.
# ═══════════════════════════════════════════════════════════

# ── Gemini AI (notes + video scripts) ───────────────────────
# Get free keys at https://aistudio.google.com/apikey
# Put several keys, comma separated. Free-tier limits are per Google Cloud
# PROJECT, so keys from different projects multiply your free quota.
GEMINI_API_KEYS=AIza_key_one,AIza_key_two
# Optional: override the model waterfall (best → lightest, comma separated)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# ── Daily tech news ─────────────────────────────────────────
NEWS_API_KEY=your_newsapi_org_key_here

# ── Cloudinary (video + thumbnail storage) ──────────────────
# NOTE: variable names must be EXACTLY these (no spaces).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Firebase Admin SDK ──────────────────────────────────────
# Paste entire serviceAccountKey.json as ONE LINE (no newlines).
# cat serviceAccountKey.json | tr -d '\n'
FIREBASE_CRED_JSON={"type":"service_account","project_id":"your-project"}

# ── Optional tuning ─────────────────────────────────────────
# MAX_CONCURRENT_VIDEO_JOBS=2     # renders at once (lower on small instances)
# VIDEO_JOB_TIMEOUT_MS=1500000    # kill a stuck render after 25 min
# ALLOW_ANON_AI=true              # LOCAL DEV ONLY: skip Firebase login on /api/notes

# ── Server port (Render sets this automatically) ────────────
PORT=3000
